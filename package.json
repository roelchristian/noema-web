{
  "name": "noema-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "npm run build && node server.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && tsc -p tsconfig.server.json && vite build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --import tsx --test test/*.test.mjs"
  },
  "dependencies": {
    "katex": "^0.19.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
